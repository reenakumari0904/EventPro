PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/eventpro
JWT_SECRET=change_this_secret

# Comma-separated list of allowed frontend origins for CORS
CORS_ORIGIN=http://localhost:5173

# Required to approve new admin signups (see POST /api/admin/register)
ADMIN_SIGNUP_CODE=change_this_invite_code

# Optional — enables the AI-generated briefing/insights/predictive-alert
# endpoints. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
