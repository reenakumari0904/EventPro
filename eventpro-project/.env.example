# Copy to `.env` in the project root before running `docker compose up`.
# docker-compose.yml reads these to configure postgres/backend/frontend together.

POSTGRES_PASSWORD=change_this_password
JWT_SECRET=change_this_to_a_long_random_string
ADMIN_SIGNUP_CODE=change_this_invite_code
CORS_ORIGIN=http://localhost:8080
VITE_API_BASE=http://localhost:5000/api

# Optional — enables AI-generated briefings/insights/predictive alerts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
